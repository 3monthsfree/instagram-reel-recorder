# Maintainer: 3monthsfree <3monthsfree@users.noreply.github.com>
pkgname=reel2mp3
pkgver=0.1.1
pkgrel=1
pkgdesc="Terminal dashboard for saving Instagram reels as MP3s"
arch=('x86_64' 'aarch64')
url="https://github.com/3monthsfree/instagram-reel-recorder"
license=('MIT')
depends=('yt-dlp' 'ffmpeg' 'gcc-libs')
makedepends=('cargo')
options=('!lto') # the release profile already sets it
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')
_srcname="instagram-reel-recorder-$pkgver"

prepare() {
    cd "$_srcname"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$_srcname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

package() {
    cd "$_srcname"
    install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "packaging/$pkgname.desktop" \
        "$pkgdir/usr/share/applications/$pkgname.desktop"
}
